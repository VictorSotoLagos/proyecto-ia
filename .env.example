# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).

# Llave de API de Anthropic, para usar la API de Claude (se crea en https://platform.claude.com)
ANTHROPIC_API_KEY=tu_llave_aqui

# Llave de API de Gemini, para los embeddings del RAG (se crea en https://aistudio.google.com)
GEMINI_API_KEY=tu_llave_aqui

# Ruta a la llave JSON de la cuenta de servicio de Google Cloud, para el tuning con PEFT en Vertex AI.
# El archivo credenciales.json es secreto y está excluido en .gitignore
GOOGLE_APPLICATION_CREDENTIALS=credenciales.json
